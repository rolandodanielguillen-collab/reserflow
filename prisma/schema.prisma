generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Auth (NextAuth) ───────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String?
  name          String?
  avatarUrl     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  brandSettings BrandSettings?
  contentIdeas  ContentIdea[]
  carousels     Carousel[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── ReserFlow: Brand Settings ─────────────────────────────────

model BrandSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  brandName       String?
  brandTagline    String?
  primaryColor    String?  @default("#0F1E3D")
  secondaryColor  String?  @default("#17B095")
  accentColor     String?  @default("#F5F2EB")
  fontPrimary     String?  @default("Archivo")
  fontSecondary   String?  @default("JetBrains Mono")
  logoUrl         String?  @db.Text
  logoDarkUrl     String?  @db.Text
  brandVoice      String?  @db.Text
  targetAudience  String?  @db.Text
  productDescription String? @db.Text
  contentPillars  String?  @db.Text

  // Instagram / Meta (metaAccessToken cifrado AES-256-GCM, ver lib/crypto.ts)
  metaAccessToken    String?   @db.Text
  instagramAccountId String?
  metaTokenUpdatedAt DateTime? // para avisar antes de que venza el long-lived (60d)
  metaTokenWarnedAt  DateTime? // último aviso de vencimiento enviado

  // WhatsApp / YCloud (legacy, reemplazado por Telegram)
  ycloudApiKey    String? @db.Text
  whatsappPhone   String?

  // Telegram (canal del operador)
  telegramChatId   String?
  telegramLinkCode String? @unique

  // Video de cierre de marca para carruseles de evento (pack final)
  closingVideoUrl String? @db.Text

  pendingApprovalCarouselId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("brand_settings")
}

// ─── ReserFlow: Content Ideas ──────────────────────────────────

model ContentIdea {
  id           String        @id @default(cuid())
  userId       String
  title        String
  topic        String?       @db.Text
  contentType  ContentType   @default(carousel)
  targetPillar String?
  status       ContentStatus @default(draft)
  scheduledAt  DateTime?
  publishedAt  DateTime?
  notes        String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  carousels Carousel[]

  @@index([userId, status])
  @@map("content_ideas")
}

// ─── ReserFlow: Carousels ──────────────────────────────────────

model Carousel {
  id               String        @id @default(cuid())
  userId           String
  contentIdeaId    String?
  title            String
  slidesCount      Int?
  slidesJson       Json?
  generationPrompt String?       @db.Text
  aiModel          String?
  status           ContentStatus @default(draft)
  caption          String?       @db.Text
  hashtags         String?       @db.Text

  // Media
  publishFormat  String   @default("carousel") // "carousel" | "reel"
  reelScriptId   String?  // Remotion script ID for auto-rendering
  coverImageUrl  String?  @db.Text
  slideImageUrls String?  @db.LongText
  videoUrl       String?  @db.Text

  // Instagram
  instagramPostId    String?
  instagramPermalink String? @db.Text

  // Scheduling
  scheduledAt DateTime?
  publishedAt DateTime?

  // Theme: true = dark (navy), false = light (cream)
  darkMode Boolean @default(true)

  // Template content piece mapping
  templatePieceId Int?

  // Ingesta de flyers (datos extraídos por GPT-4o Vision)
  extractedJson Json?
  sourceFlyerUrl String? @db.Text

  // Campañas
  campaignId String?

  // Error handling
  failReason String? @db.Text
  retryCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentIdea ContentIdea? @relation(fields: [contentIdeaId], references: [id], onDelete: SetNull)
  campaign    Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([scheduledAt])
  @@map("carousels")
}

// ─── Telegram: estado conversacional por chat ──────────────────

model TelegramChatState {
  id        String   @id @default(cuid())
  chatId    String   @unique
  state     Json?
  updatedAt DateTime @updatedAt

  @@map("telegram_chat_state")
}

// ─── Biblioteca de imágenes por tenant ─────────────────────────

model Asset {
  id             String    @id @default(cuid())
  userId         String
  url            String    @db.Text
  filename       String
  mimeType       String?
  width          Int?
  height         Int?
  sizeBytes      Int?
  tags           Json?     // ["jugador","cancha",...] — auto-tag IA + manual
  dominantColors Json?     // ["#aabbcc", ...]
  orientation    String?   // portrait | landscape | square
  textSpace      String?   // top | bottom | left | right | center | none
  useCount       Int       @default(0)
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@map("assets")
}

// ─── Campañas de marketing ─────────────────────────────────────

model Campaign {
  id          String    @id @default(cuid())
  userId      String
  name        String
  objective   String?   @db.Text
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  status      String    @default("activa") // activa | pausada | terminada
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  carousels Carousel[]
  adIntents AdIntent[]

  @@index([userId])
  @@map("campaigns")
}

// ─── Meta Ads (modo preparado hasta tener app review) ──────────

model AdIntent {
  id         String    @id @default(cuid())
  userId     String
  carouselId String?
  campaignId String?
  budget     Float?
  durationDays Int?
  objective  String?
  status     String    @default("sin_conexion") // sin_conexion | creado | activo | error
  metaAdId   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("ad_intents")
}

// ─── Métricas orgánicas por publicación ────────────────────────

model PostInsight {
  id          String   @id @default(cuid())
  carouselId  String   @unique
  reach       Int?
  likes       Int?
  comments    Int?
  saved       Int?
  shares      Int?
  fetchedAt   DateTime @updatedAt

  @@map("post_insights")
}

// ─── Enums ─────────────────────────────────────────────────────

enum ContentStatus {
  draft
  generating
  review
  approved
  scheduled
  publishing
  published
  failed

  @@map("content_status")
}

enum ContentType {
  carousel
  video
  reel
  story

  @@map("content_type")
}
