# ─── Database (MariaDB via Prisma) ──────────────────
DATABASE_URL="mysql://user:password@localhost:3306/reserplus_flow"

# ─── NextAuth ───────────────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="https://reserflow.reserplus.com"

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Site ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://reserflow.reserplus.com"

# ─── OpenAI ─────────────────────────────────────────
OPENAI_API_KEY=""

# ─── Cloudinary ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── YCloud (WhatsApp) ─────────────────────────────
YCLOUD_API_KEY=""
YCLOUD_WEBHOOK_SECRET=""
YCLOUD_WHATSAPP_FROM=""
YCLOUD_ADMIN_PHONE=""

# ─── Cron ──────────────────────────────────────────
CRON_SECRET=""

# ─── Image Generation ──────────────────────────────
GOOGLE_AI_API_KEY=""
PEXELS_API_KEY=""

# ─── BotFlow ──────────────────────────────────────
BOTFLOW_WEBHOOK_URL=""

# ─── Uploads (local storage) ──────────────────────
UPLOADS_DIR="/var/www/reserplus/public/uploads"
